# ==================================================
# TWILIO WHATSAPP CONFIGURATION
# ==================================================
# Copy this file to .env and fill in your credentials
# Get these values from: https://console.twilio.com

# Twilio Account Credentials
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# WhatsApp Configuration
# Format: whatsapp:+14155238886 (Twilio Sandbox number)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ==================================================
# FLASK CONFIGURATION
# ==================================================
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000

# ==================================================
# WEBHOOK CONFIGURATION
# ==================================================
# Your public URL (ngrok or production domain)
# Example: https://abc123.ngrok.io
WEBHOOK_URL=https://your-ngrok-url.ngrok.io

# ==================================================
# FILE STORAGE
# ==================================================
# Directory for uploaded certificates
CERTIFICATES_DIR=./certificates

# ==================================================
# NOTES
# ==================================================
# 1. Never commit the .env file with real credentials
# 2. Add .env to .gitignore
# 3. For production, use proper secrets management
# 4. Twilio Sandbox is free but has limitations
# 5. Get production WhatsApp number after testing
