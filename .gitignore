# OPERATING SYSTEM
# ==================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ==================================================
# TEMPORARY FILES
# ==================================================
# Temporary files
tmp/
temp/
*.tmp
*.bak
*.swp

# ==================================================
# NGROK
# ==================================================
# ngrok configuration
ngrok.yml
ngrok.exe

# ==================================================
# JUPYTER NOTEBOOKS
