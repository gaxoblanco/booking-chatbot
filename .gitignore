# ==================================================
# WHATSAPP BOT - GITIGNORE
# ==================================================
# Prevents committing sensitive data and temporary files

# ==================================================
# ENVIRONMENT & SECRETS
# ==================================================
# Never commit credentials or API keys
.env
.env.local
.env.*.local
*.env

# Twilio credentials
twilio.json
credentials.json

# ==================================================
# CERTIFICATES & UPLOADS
# ==================================================
# User-uploaded files (certificates, images, PDFs)
certificates/
uploads/
media/
*.jpg
*.jpeg
*.png
*.gif
*.pdf
*.webp

# But keep the directory structure
!certificates/.gitkeep
!uploads/.gitkeep

# ==================================================
# PYTHON
# ==================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# ==================================================
# DOCKER
# ==================================================
# Docker volumes
docker-compose.override.yml
.dockerignore

# ==================================================
# DATABASE
# ==================================================
# SQLite databases (development)
*.db
*.sqlite
*.sqlite3
database.db

# Database backups
*.sql
*.dump

# ==================================================
