.ipynb_checkpoints/
*.ipynb

# ==================================================
# DOCUMENTATION BUILD
# ==================================================
docs/_build/
site/

# ==================================================
# TESTING
# ==================================================
.tox/
.coverage
htmlcov/

# ==================================================
# NOTES & TODO
# ==================================================
# Personal notes (keep TODO.md if you want)
NOTES.md
TODO.txt
scratch.md

# ==================================================
# KEEP THESE FILES
# ==================================================
# Examples and templates should be committed
!.env.example
!.gitkeep
!README*.md
!LICENSE

# ==================================================
# MACHINE LEARNING — scripts/ml (modelo local legacy)
# ==================================================
# Modelos entrenados pesados (~50MB) — NO commitear
scripts/ml/models/intent_classifier/
scripts/ml/models/intent_classifier/*
scripts/ml/models/intent_classifier_best/
scripts/ml/models/intent_classifier_best/*

# Datos generados por entrenamiento
scripts/ml/intent_classifier/training_report.json

# ==================================================
# MACHINE LEARNING — ml-intent-service (servicio en raíz)
# ==================================================
# Modelo spaCy entrenado — pesado, NO va en git
ml-intent-service/models/
ml-intent-service/models/**

# Archivos binarios de spaCy
ml-intent-service/**/*.spacy

# Caché de Python dentro del servicio
ml-intent-service/__pycache__/
ml-intent-service/**/__pycache__/

# Entorno virtual propio del servicio (si lo tiene)
ml-intent-service/venv/
ml-intent-service/.venv/
ml-intent-service/env/

# Variables de entorno propias del servicio
ml-intent-service/.env
ml-intent-service/.env.local

# Logs propios del servicio
ml-intent-service/logs/
ml-intent-service/*.log

# Archivos temporales de entrenamiento
ml-intent-service/training_report.json
ml-intent-service/**/training_report.json

# MANTENER estructura de carpetas vacías
!ml-intent-service/models/.gitkeep

ml-intent-service/models/
ml-intent-service/models/**
ml-intent-service/scripts/ml/models/
ml-intent-service/scripts/ml/models/**