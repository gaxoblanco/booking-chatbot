# ML Intent Service - Environment Variables
# Copiar este archivo a .env y configurar según necesidad

# ==========================================
# CONFIGURACIÓN DEL MODELO
# ==========================================
MODEL_PATH=models/intent_classifier
# Ruta al modelo spaCy entrenado

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO
# Niveles disponibles: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ==========================================
# SERVIDOR
# ==========================================
HOST=0.0.0.0
PORT=8000
WORKERS=4
# Número de workers uvicorn (ajustar según CPU)
# Recomendación: (2 x CPU cores) + 1

RELOAD=false
# Hot reload para desarrollo (true) o producción (false)

# ==========================================
# SEGURIDAD
# ==========================================

# API Key Authentication
API_KEY_ENABLED=false
# Generar con: python app/security.py
API_KEY=

# IP Whitelist (opcional)
IP_WHITELIST_ENABLED=false
# Formato JSON: ["172.18.0.0/16","10.0.0.0/8"]
IP_WHITELIST=[]

# Rate Limiting (futuro)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# CORS
# En desarrollo: ["*"]
# En producción: ["https://app.tudominio.com"]
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST"]
CORS_ALLOW_HEADERS=["*"]

# ==========================================
# CACHE (FUTURO)
# ==========================================
# CACHE_ENABLED=false
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# CACHE_TTL_SECONDS=3600

# ==========================================
# MONITOREO (FUTURO)
# ==========================================
# METRICS_ENABLED=false
# METRICS_PORT=9090

# ==========================================
# TIMEZONE
# ==========================================
TZ=America/Argentina/Buenos_Aires
