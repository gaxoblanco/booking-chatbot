# ML Intent Service - PRODUCCIÓN
# ============================================
# IMPORTANTE: NO commitear este archivo a git
# ============================================

# ==========================================
# MODELO ML
# ==========================================
MODEL_PATH=models/intent_classifier

# ==========================================
# SERVIDOR
# ==========================================
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=WARNING
# En producción usar WARNING o ERROR para reducir logs sensibles
# DEBUG solo para troubleshooting temporal

# ==========================================
# SEGURIDAD - API KEY ⭐ CRÍTICO
# ==========================================
API_KEY_ENABLED=true
# IMPORTANTE: Cambiar esta key!
# Generar con: python app/security.py
API_KEY=CHANGE_ME_GENERATE_NEW_KEY_WITH_python_app_security_py

# ==========================================
# SEGURIDAD - IP WHITELIST (OPCIONAL)
# ==========================================
# Si solo ciertos contenedores/IPs pueden acceder
IP_WHITELIST_ENABLED=false
# Ejemplo: IP_WHITELIST=["172.18.0.0/16","10.0.0.0/8"]
IP_WHITELIST=[]

# ==========================================
# SEGURIDAD - RATE LIMITING (FUTURO)
# ==========================================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# ==========================================
# SEGURIDAD - CORS
# ==========================================
# En producción: lista específica de dominios permitidos
# Formato JSON: ["https://app1.ejemplo.com","https://app2.ejemplo.com"]
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST"]
CORS_ALLOW_HEADERS=["*"]

# ==========================================
# MONITOREO (FUTURO)
# ==========================================
METRICS_ENABLED=false
METRICS_PORT=9090

# ==========================================
# TIMEZONE
# ==========================================
TZ=America/Argentina/Buenos_Aires
