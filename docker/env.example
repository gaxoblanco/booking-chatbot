# ==================================================
# TWILIO — WhatsApp Business API
# ==================================================

# SID de tu cuenta Twilio (empieza con AC)
# Dónde encontrarlo: console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=XXXXXXX

# Token de autenticación de Twilio
# Dónde encontrarlo: console.twilio.com → Account Info → Auth Token
# IMPORTANTE: se usa también para validar la firma de cada mensaje entrante (S1)
TWILIO_AUTH_TOKEN=XXXXXXX

# Número de WhatsApp Business asignado por Twilio (con prefijo whatsapp:)
# Sandbox de prueba: whatsapp:+14155238886
# Número propio: whatsapp:+549XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=whatsapp:+5493705217649

# SID del template aprobado para recordatorios de turnos
# Dónde encontrarlo: console.twilio.com → Messaging → Content Editor
# Formato esperado del template: "Recordatorio: tenés turno el {fecha} a las {hora}"
TWILIO_REMINDER_TEMPLATE_SID=XXXXXXX

# SID del template aprobado para ofertas de waitlist (turno adelantado disponible)
# Formato esperado del template: "Se liberó un turno antes. ¿Lo querés?"
TWILIO_SLOT_OFFER_TEMPLATE_SID=XXXXXXX


# ==================================================
# DOMINIO DEL NEGOCIO
# ==================================================

# Preset que define el vocabulario y comportamiento del bot
# Opciones: SALUD | PSICOLOGIA | BELLEZA | LEGAL | FITNESS | EDUCACION | HOGAR
# Afecta: nombre del turno (sesión/cita/turno), políticas de cancelación, filtros habilitados
DOMAIN_PRESET=SALUD


# ==================================================
# TONO Y PERSONALIDAD
# ==================================================

# Tono de comunicación del bot
# Opciones:
#   demo      → aspiracional, orientado a mostrar el producto
#               "Así de fácil funciona Salud Conecta."
#   coloquial → vecinal, directo, para centros de salud locales
#               "Listo, tu turno está confirmado. El profesional te espera."
#
# Para agregar un tono nuevo:
#   1. Crear src/messages/tones/nuevo_tono.py
#   2. Registrarlo en src/messages/loader.py (REGISTERED)
#   3. Cambiar este valor y reiniciar el container
TENANT_TONE=coloquial


# ==================================================
# ENTORNO
# ==================================================

# Entorno de ejecución
# development: omite validación de firma Twilio, logs verbosos, recarga CSV automática
# production:  valida firma Twilio, requiere MASTER_ACCESS_KEY, logs sanitizados
FLASK_ENV=development
ENVIRONMENT=development

# Debug mode de Flask (solo development — nunca True en production)
FLASK_DEBUG=True

# Puerto interno del container (el docker-compose mapea este puerto al host)
FLASK_PORT=5000


# ==================================================
# WEBHOOKS
# ==================================================

# URL pública del servidor (sin barra final)
# Se usa para:
#   1. Validar la firma Twilio (debe coincidir exactamente con la URL configurada en Twilio)
#   2. Construir GOOGLE_CALENDAR_WEBHOOK_URL si no está definida
# En development con ngrok: https://xxxx.ngrok-free.app
# En production: https://tu-dominio.com
WEBHOOK_URL=https://mi_web.com.ar

# URL completa del endpoint que Google Calendar usa para push notifications
# Google hace POST aquí cuando un profesional modifica su calendario
# DEBE ser HTTPS y accesible desde internet
# Formato: ${WEBHOOK_URL}/google-calendar/webhook
GOOGLE_CALENDAR_WEBHOOK_URL=https://mi_web.com.ar/google-calendar/webhook


# ==================================================
# REDIS — Sesiones persistentes
# ==================================================

# URL de conexión a Redis
# Sin auth (development): redis://redis:6379/0
# Con auth (production):  redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_URL=redis://redis:6379/0

# Contraseña de Redis — REQUERIDA en production
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Debe coincidir con --requirepass en docker-compose.yml
# REDIS_PASSWORD=


# ==================================================
# ACCESO ADMINISTRATIVO
# ==================================================

# Clave para operaciones de administración y testing
# NO es para profesionales — los profesionales se cargan via CSV por el admin
# En production: REQUERIDA o el sistema no arranca
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(16))"
MASTER_ACCESS_KEY=ADMIN2025

# Si una misma clave puede usarse más de una vez (siempre false en production)
ALLOW_KEY_REUSE=false


# ==================================================
# ML — Servicio de detección de intenciones
# ==================================================

# URL del container ml-intent-service (spaCy, 98.1% accuracy)
# Solo accesible dentro de la red Docker — no se expone al exterior
ML_SERVICE_URL=http://ml-service:8000

# API key para autenticar requests al servicio ML
ML_API_KEY=XXXXXXXX


# ==================================================
# EMAIL / SMTP — Invitaciones a profesionales
# ==================================================

# Servidor SMTP para enviar invitaciones de Google Calendar a profesionales nuevos
SMTP_HOST=mail.miweb.com
SMTP_PORT=587
SMTP_USER=sistema@miweb.com
SMTP_PASSWORD=tu_password
SMTP_FROM_NAME=Mi Sistema de Turnos


# ==================================================
# ALMACENAMIENTO
# ==================================================

# Directorio para guardar archivos subidos (certificados, etc.)
CERTIFICATES_DIR=./data/certificates
