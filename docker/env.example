# ==================================================
# META — WhatsApp Business Cloud API
# ==================================================
# Reemplaza Twilio. Sin intermediario — directo a Meta.
#
# Dónde conseguir estos valores:
#   developers.facebook.com → Tu App → WhatsApp → Configuración de la API

# ID del número de teléfono de WhatsApp (NO es el número en sí)
# Dónde encontrarlo: WhatsApp → Configuración de la API → "Phone number ID"
META_PHONE_NUMBER_ID=XXXXXXX

# Token de acceso permanente de la app
# Cómo generarlo: Meta Business Suite → Configuración → Usuarios del sistema
#   → Agregar usuario del sistema (admin) → Generar token → seleccionar la app
#   → permisos: whatsapp_business_messaging, whatsapp_business_management
# IMPORTANTE: el token temporal del panel expira en 24hs — usar SIEMPRE token permanente
META_WHATSAPP_TOKEN=XXXXXXX

# Token de verificación del webhook (lo elegís vos, string cualquiera)
# Meta hace un GET a /webhook con este token para verificar que el servidor es tuyo
# Puede ser cualquier string secreto, ej: python -c "import secrets; print(secrets.token_urlsafe(16))"
META_WEBHOOK_VERIFY_TOKEN=XXXXXXX

# App Secret de la app de Meta
# Dónde encontrarlo: Configuración de la app → Básico → "Clave secreta de la app"
# Se usa para validar la firma X-Hub-Signature-256 de cada mensaje entrante
META_APP_SECRET=XXXXXXX

# Versión de la API de Meta a usar (actualizar cuando Meta depreca versiones)
# Ver versiones disponibles: developers.facebook.com/docs/graph-api/changelog
META_API_VERSION=v22.0

# ID de plantilla aprobada para recordatorios de turnos
# Dónde encontrarlo: Meta Business Suite → Cuenta de WhatsApp → Plantillas de mensajes
# Formato esperado del template: "Recordatorio: tenés turno el {{1}} a las {{2}}"
META_REMINDER_TEMPLATE_NAME=recordatorio_turno
META_REMINDER_TEMPLATE_LANG=es_AR

# ID de plantilla aprobada para ofertas de waitlist (turno adelantado disponible)
# Formato esperado del template: "Se liberó un turno antes. ¿Lo querés?"
META_SLOT_OFFER_TEMPLATE_NAME=oferta_turno_adelantado
META_SLOT_OFFER_TEMPLATE_LANG=es_AR


# ==================================================
# DOMINIO DEL NEGOCIO
# ==================================================

# Preset que define el vocabulario y comportamiento del bot
# Opciones: SALUD | PSICOLOGIA | BELLEZA | LEGAL | FITNESS | EDUCACION | HOGAR
# Afecta: nombre del turno (sesión/cita/turno), políticas de cancelación, filtros habilitados
DOMAIN_PRESET=SALUD


# ==================================================
# TONO Y PERSONALIDAD
# ==================================================

# Tono de comunicación del bot
# Opciones:
#   demo      → aspiracional, orientado a mostrar el producto
#               "Así de fácil funciona Salud Conecta."
#   coloquial → vecinal, directo, para centros de salud locales
#               "Listo, tu turno está confirmado. El profesional te espera."
#
# Para agregar un tono nuevo:
#   1. Crear src/messages/tones/nuevo_tono.py
#   2. Registrarlo en src/messages/loader.py (REGISTERED)
#   3. Cambiar este valor y reiniciar el container
TENANT_TONE=coloquial

# ==========================================
# MEET LINK — Google Meet
# ==========================================
MEET_LINK_MODE=always

# ==========================================
# SINGLE PROFESSIONAL MODE
# ==========================================
SINGLE_PROFESSIONAL_MODE=true
SINGLE_PROFESSIONAL_PHONE=+5491100000001

# ==================================================
# ENTORNO
# ==================================================

# Entorno de ejecución
# development: omite validación de firma Meta, logs verbosos, recarga CSV automática
# production:  valida firma X-Hub-Signature-256, requiere MASTER_ACCESS_KEY, logs sanitizados
FLASK_ENV=development
ENVIRONMENT=development

# Debug mode de Flask (solo development — nunca True en production)
FLASK_DEBUG=True

# Puerto interno del container (el docker-compose mapea este puerto al host)
FLASK_PORT=5000


# ==================================================
# WEBHOOKS
# ==================================================

# URL pública del servidor (sin barra final)
# Se usa para:
#   1. Validar la firma Meta (debe coincidir con la URL configurada en el panel)
#   2. Construir GOOGLE_CALENDAR_WEBHOOK_URL si no está definida
# En production: https://gaxoblanco.com
WEBHOOK_URL=https://gaxoblanco.com

# Ruta del endpoint de WhatsApp (Meta hace GET y POST aquí)
# Configurar esta URL exacta en: developers.facebook.com → App → WhatsApp → Configuración
# → Webhooks → URL de devolución de llamada
WEBHOOK_PATH=/webhook

# URL completa del endpoint que Google Calendar usa para push notifications
# Google hace POST aquí cuando un profesional modifica su calendario
# DEBE ser HTTPS y accesible desde internet
GOOGLE_CALENDAR_WEBHOOK_URL=https://gaxoblanco.com/google-calendar/webhook


# ==================================================
# REDIS — Sesiones persistentes
# ==================================================

# URL de conexión a Redis
# Sin auth (development): redis://redis:6379/0
# Con auth (production):  redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_URL=redis://redis:6379/0

# Contraseña de Redis — REQUERIDA en production
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Debe coincidir con --requirepass en docker-compose.yml
# REDIS_PASSWORD=


# ==================================================
# ACCESO ADMINISTRATIVO
# ==================================================

# Clave para operaciones de administración y testing
# NO es para profesionales — los profesionales se cargan via CSV por el admin
# En production: REQUERIDA o el sistema no arranca
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(16))"
MASTER_ACCESS_KEY=ADMIN2025

# Si una misma clave puede usarse más de una vez (siempre false en production)
ALLOW_KEY_REUSE=false


# ==================================================
# ML — Servicio de detección de intenciones
# ==================================================

# URL del container ml-intent-service (spaCy, 98.1% accuracy)
# Solo accesible dentro de la red Docker — no se expone al exterior
ML_SERVICE_URL=http://ml-service:8000

# API key para autenticar requests al servicio ML
ML_API_KEY=XXXXXXXX


# ==================================================
# EMAIL / SMTP — Invitaciones a profesionales
# ==================================================

# Servidor SMTP para enviar invitaciones de Google Calendar a profesionales nuevos
SMTP_HOST=c1332437.ferozo.com
SMTP_PORT=465
SMTP_USER=gestor_ageda@gaxoblanco.com
SMTP_PASSWORD=XXXXXXX
SMTP_FROM_NAME=Agenda Asistida


# ==================================================
# ALMACENAMIENTO
# ==================================================

# Directorio para guardar archivos subidos (certificados, etc.)
CERTIFICATES_DIR=./data/certificates


# ==================================================
# POLÍTICAS DE GESTIÓN DE TURNOS
# ==================================================

# Horas mínimas de anticipación para que el cliente pueda REPROGRAMAR
RESCHEDULE_HOURS_LIMIT=22

# Hora de envío de recordatorios automáticos (formato HH:MM, 24hs)
REMINDER_SEND_TIME=17:30

# Hora límite para aceptar respuestas al recordatorio (formato HH:MM, 24hs)
REMINDER_CLOSE_TIME=20:30


# ==================================================
# EXTRAS
# ==================================================
NOTIFY_PROFESSIONAL=true

# Datos del centro para mensajes automáticos
CENTER_EMAIL=contacto@gaxoblanco.com
CENTER_HOURS_WD=9:00 - 18:00
CENTER_HOURS_SAT=9:00 - 13:00
CENTER_PHONE=+54 370 000-0000
